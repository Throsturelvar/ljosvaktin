
{
  "name": "northseek-api",
  "main": "main.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "vars": {
    "MET_USER_AGENT": "Northseek/1.0 (sjmalun@gmail.com)"
  },
  "kv_namespaces": [
    {
      "binding": "NORTHSEEK_CACHE",
      "id": "d8d9b7ad0c984df2b32af5cd61d7c1a4"
    }
  ],
  "triggers": {
    "crons": [
      "0 */3 * * *",
      "*/20 * * * *",
      "*/5 * * * *",
      "7,17,27,37,47,57 * * * *",
      "13 * * * *"
    ]
  }
}
