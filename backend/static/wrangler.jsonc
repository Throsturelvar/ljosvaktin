{
  "name": "northseek",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "MAELING_DB", "database_name": "northseek-maeling", "database_id": "71444dbf-4b68-4677-99e2-549b1a309bd2" }
  ],
  "services": [
    {
      "binding": "NORTHSEEK_API",
      "service": "northseek-api-js"
    }
  ]
}
