{
  "name": "northseek",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "NORTHSEEK_API",
      "service": "northseek-api-js"
    }
  ]
}
