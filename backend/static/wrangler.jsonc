{
  "name": "northseek",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    { "binding": "MAELING", "dataset": "northseek_uppruni" }
  ],
  "services": [
    {
      "binding": "NORTHSEEK_API",
      "service": "northseek-api-js"
    }
  ]
}
